# Force LF line endings for all shell scripts and Python files (Linux server compatibility)
*.sh        text eol=lf
*.py        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
*.env*      text eol=lf
Dockerfile* text eol=lf
*.csv       text eol=lf

# Binary files — no line-ending conversion
*.db        binary
*.sqlite3   binary
*.pyc       binary
*.png       binary
*.jpg       binary
*.pdf       binary

# Model weights are ORDINARY binary files, not Git LFS: servers are deployed from archives / checkouts without
# git-lfs, which then shipped a 133-byte LFS pointer instead of the model. A normal blob is in every clone,
# Jenkins checkout and tarball.
*.safetensors -filter binary
