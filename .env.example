# ==============================================================================
# AI MEETING INTELLIGENCE PLATFORM — TEMPLATE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust the configuration as required.
# Never commit .env with real credentials or API keys to version control.
# ==============================================================================

# ─── AI providers ────────────────────────────────────────────────────────────
# AI_PROVIDER: the ONE service that writes summaries, minutes, decisions, action items and chat answers.
#   airawat (default) | ollama (local - nothing leaves the host) | groq | gemini (cloud - meeting text is sent there)
# STT_PROVIDER: speech-to-text. airawat | groq. Leave empty to use AI_PROVIDER when it can transcribe
#   (airawat, groq). REQUIRED with AI_PROVIDER=ollama or gemini - they do not transcribe in this application.
# A failing provider is retried and then the meeting fails with a clear message; another provider is NEVER
# used in its place. Model ids change: check them with  python -m backend.scripts.check_ai_provider

# ─── Ollama (local) ──────────────────────────────────────────────────────────
# The model must be installed on that server:  ollama pull <model>   (list: ollama list)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=120

# ─── Groq (cloud) ────────────────────────────────────────────────────────────
# Key: https://console.groq.com   (both model ids below were offered by Groq on 2026-10-21)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TIMEOUT_SEC=60

# ─── Google Gemini (cloud, text generation only) ─────────────────────────────
# Key: https://aistudio.google.com   (gemini-1.5-* models are retired; gemini-2.5-flash was offered on 2026-10-21)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=60

# ─── AIRAWAT gateway ─────────────────────────────────────────────────────────
# AIRAWAT cannot detect the spoken language: uploads name it, else DEFAULT_WHISPER_LANGUAGE is used.
AIRAWAT_API_KEY=
# Minimum relevance (cosine similarity) of a passage shown by the search page
SEARCH_MIN_SIMILARITY=0.2

# ─── Database Configuration ──────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=govindb
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/govindb

# SQLite alternative for standalone lightweight deployments:
# DATABASE_URL=sqlite:///./data/ai_meeting.db

# ─── Application Settings ────────────────────────────────────────────────────
APP_NAME="AI Meeting Intelligence Platform"
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs

# ─── Storage Paths ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
VECTOR_DB=chromadb
CHROMA_PERSIST_DIRECTORY=./data/chroma
NEMO_CACHE_DIR=./nemo_cache
MAX_FILE_SIZE_MB=500
UPLOAD_CHUNK_SIZE_BYTES=4194304
UPLOAD_CLIPS_DIR=clips

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=your_strong_secret_key_here
JWT_SECRET=your_strong_jwt_secret_here
SSL_VERIFY=true
ENABLE_SWAGGER=true
# Protects the administration API and page (/admin/settings). EMPTY = those endpoints are OPEN to anyone who can
# reach the server: set a long random value on every shared deployment.
ADMIN_API_KEY=

# ─── LLM Generation & Timeout Parameters ─────────────────────────────────────
MAX_TOKENS=2000
TEMPERATURE=0.1
STREAMING=true
DIARIZATION_OVERLAP_WITH_STT=false

# ─── Summary & Minutes of Meeting (MoM) ──────────────────────────────────────
SUMMARY_LENGTH_COEFF=2.4
SUMMARY_MIN_WORDS=30
SUMMARY_MAX_WORDS=200
SUMMARY_MAX_REPAIRS=2

# ─── Reference-free Quality Scores ───────────────────────────────────────────
TQ_COVERAGE_FULL=0.50
TQ_WPM_FULL=30

# ─── Database Connection Pool ────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=600
DB_STATEMENT_TIMEOUT_MS=0
DB_SSL=false
DB_POOL_CONNECT_TIMEOUT=30
DB_CONNECTION_TIMEOUT=5
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY_S=1.0

# ─── Speaker Diarization ─────────────────────────────────────────────────────
NEMO_ENABLED=true
NEMO_DEVICE=auto
NEMO_SPEAKER_MODEL=titanet_large
NEMO_VAD_MODEL=vad_multilingual_marblenet
ENABLE_LLM_SPEAKER_LABELS=true
PYANNOTE_ENABLED=false
HF_TOKEN=
DIARIZATION_MODE=NEMO_ONLY
DIARIZATION_MAX_SPEAKERS=8
DIARIZATION_NEURAL_DIST_THRESHOLD=0.62
DIARIZATION_NEURAL_MERGE_COSINE=0.30
DIARIZATION_CLUSTER_MERGE_COSINE=0.50
DIARIZATION_MIN_SPEAKER_TALK_SEC=3.0
DIARIZATION_VAD_MARGIN_DB=9.0
DIARIZATION_SENTENCE_SMOOTHING=true

# ─── Voice Enrollment & Profiles ─────────────────────────────────────────────
VOICE_ENROLLMENT_ENABLED=true
VOICE_PROFILE_DIR=./uploads/voice_profiles
VOICE_MATCH_THRESHOLD=0.62
VOICE_MATCH_MARGIN=0.06
VOICE_MIN_ENROLL_SPEECH_SEC=3.0
VOICE_MIN_MATCH_SPEECH_SEC=2.0

# ─── Multilingual & Audio Pipeline ───────────────────────────────────────────
MULTILINGUAL_ENABLED=true
TRANSLATION_ENABLED=true
OUTPUT_LANGUAGE=en
DEFAULT_WHISPER_LANGUAGE=en
TRANSLATION_BATCH_SIZE=20
TRANSLATION_MAX_RETRIES=2
CLOUD_MAX_BYTES=15728640
CLOUD_HARD_MAX_BYTES=25165824
BYTES_PER_SEC_WAV=32000
CHUNK_OVERLAP_SEC=0.5

# ─── Offline & Embedding Models ──────────────────────────────────────────────
OFFLINE_MODE=false
MODEL_BASE_PATH=./models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=./models/embeddings/all-MiniLM-L6-v2
EMBEDDING_MODEL_REQUIRED=false

# ─── ChromaDB Vector Database ────────────────────────────────────────────────
UVICORN_WORKERS=1
VECTOR_BACKFILL_ON_STARTUP=false

# ─── Report Branding ─────────────────────────────────────────────────────────
REPORT_COMPANY_NAME="AI Meeting Intelligence"
REPORT_COMPANY_ADDRESS="Confidential"
REPORT_HEADER_TEXT="Executive Meeting Intelligence Report"
REPORT_FOOTER_TEXT="AI Meeting Intelligence Platform"
